# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://hugo:hugo@localhost:5432/hugo
# Set to true to use NullPool (required for Alembic; set automatically in alembic/env.py)
DB_ECHO=false

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_MAX_TOKENS=4096
ANTHROPIC_THINKING_BUDGET=2048

# ── Voyage AI (embeddings) ────────────────────────────────────────────────────
VOYAGE_API_KEY=pa-...
VOYAGE_MODEL=voyage-3
EMBEDDING_DIM=1024

# ── Session / Auth ────────────────────────────────────────────────────────────
SESSION_SECRET=change-me-in-production-use-openssl-rand-hex-32
SESSION_TTL_SECONDS=86400

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_MESSAGES_PER_MINUTE=60

# ── Agent loop ────────────────────────────────────────────────────────────────
MAX_TOOL_ITERATIONS=5
TOOL_TIMEOUT_SECONDS=30
ROLLING_SUMMARY_TOKEN_THRESHOLD=60000

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000

# ── Mock providers (offline dev / CI) ────────────────────────────────────────
# Set to true to skip all external API calls
MOCK_PROVIDERS=false

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_JSON=true
